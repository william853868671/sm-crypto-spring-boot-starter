<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 基本信息 -->
    <groupId>io.github.william853868671</groupId>
    <artifactId>sm-crypto-spring-boot-starter</artifactId>
    <version>2.0.3</version>
    <packaging>jar</packaging>

    <name>SM Crypto Spring Boot Starter</name>
    <description>
        前后端国密（SM2 + SM4）返回体加密 Spring Boot Starter。
        后端用一次性随机 SM4 密钥加密返回体，再用【前端 SM2 公钥】加密该密钥，
        只有持有配对私钥的前端能还原业务数据；与微信小程序 sm-crypto 跨语言互通。
    </description>
    <url>https://github.com/william853868671/sm-crypto-spring-boot-starter</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>william</id>
            <name>William</name>
            <email>william853868671@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/william853868671/sm-crypto-spring-boot-starter.git</connection>
        <developerConnection>scm:git:ssh://github.com:william853868671/sm-crypto-spring-boot-starter.git</developerConnection>
        <url>https://github.com/william853868671/sm-crypto-spring-boot-starter</url>
    </scm>

    <!--
        说明：这是一个 Spring Boot Starter 库，不继承 spring-boot-starter-parent，
        改为通过 dependencyManagement 引入 spring-boot-dependencies BOM，避免把库的
        Spring Boot 版本强塞给使用方（使用方可以自由选择兼容的 Spring Boot 版本）。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.5.16</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Hutool 5.8.x：SM2 的 encryptBcd / decryptStrFromBcd 已按 C1C3C2 实现，与前端 sm-crypto 互通 -->
        <hutool.version>5.8.33</hutool.version>
        <!-- Hutool 的 SM2 底层依赖 BouncyCastle，必须显式声明。
             1.85 修复 GHSA-9pwp-9qqc-pr26 (CVE-2026-8763, Name Constraints 绕过, 9.1)、
             GHSA-qp49-qgx5-5m26 (ASN.1 嵌套, 7.5)、GHSA-c3fc-8qff-9hwx (LDAP 注入, 5.5) -->
        <bouncycastle.version>1.85</bouncycastle.version>
    </properties>

    <dependencies>
        <!-- Spring Boot 自动配置（starter 必需） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Web 支持：ResponseBodyAdvice / @RestControllerAdvice 基于 Servlet MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 配置元数据（smcfb.* 在 IDE 里自动提示），仅编译期需要 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 国密工具（SM2 / SM4） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- BouncyCastle：Hutool SM2 的底层实现 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 编译（不继承 parent，需显式指定 Java 版本） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
            </plugin>

            <!-- 运行测试（自测套件） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <!-- 源码包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc 包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <doclint>none</doclint>
                    <failOnError>false</failOnError>
                    <source>${java.version}</source>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- GPG 签名（发布到 Maven Central 必需） -->
            <!-- keys.openpgp.org -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <gpgArguments>
                                <arg>--batch</arg>
                                <arg>--yes</arg>
                                <arg>--pinentry-mode=loopback</arg>
                            </gpgArguments>
                            <!--
                                加密密码：使用 Maven 提供的 mvn -encrypt-master-password 和 mvn -encrypt-password 命令来加密你的密码
                                mvn -encrypt-master-password
                                # 输入并记住生成的 master 密码
                                ~/.m2/settings-security.xml
                                <settingsSecurity>
                                  <master>{encryptedMasterPassword}</master>
                                </settingsSecurity>
                                mvn -encrypt-password your-passphrase
                                # 将输出的加密后的密码用于下一步
                                编辑 ~/.m2/settings.xml
                                <servers>
                                  <server>
                                    <id>gpg-signing</id>
                                    <passphrase>{encryptedPassphrase}</passphrase>
                                  </server>
                                </servers>
                            -->
                            <passphraseServerId>gpg-signing</passphraseServerId>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 发布到 Maven Central（Central Portal） -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.11.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        发布到私有 Nexus 仓库（maven-7138）。
        激活方式：mvn -Pnexus clean deploy
        该 profile 会：
          1. 将 distributionManagement 指向私服 maven-releases / maven-snapshots；
          2. 关闭 central-publishing 插件（否则它会劫持 deploy 阶段去发 Maven Central）；
          3. 关闭 GPG 签名（私服无需签名）。
        认证信息在 ~/.m2/settings.xml 的 <server><id>maven-7138</id> 中。
    -->
    <profiles>
        <profile>
            <id>nexus</id>
            <distributionManagement>
                <repository>
                    <id>maven-7138</id>
                    <name>Bulade Nexus Releases</name>
                    <url>http://172.0.71.38:8081/repository/maven-releases</url>
                </repository>
                <snapshotRepository>
                    <id>maven-7138</id>
                    <name>Bulade Nexus Snapshots</name>
                    <url>http://172.0.71.38:8081/repository/maven-snapshots</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 私服发布时禁用 Maven Central Portal 插件 -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <extensions>false</extensions>
                    </plugin>
                    <!-- 私服发布时禁用 GPG 签名 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
