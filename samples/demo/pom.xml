<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.william853868671</groupId>
    <artifactId>sm-crypto-spring-boot-starter-sample</artifactId>
    <version>1.0.0</version>
    <name>SM Crypto Starter Sample</name>
    <description>可运行的演示应用：使用 sm-crypto-spring-boot-starter 加密返回体</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 本仓库的 starter（需先在仓库根目录执行 mvn -q install 安装到本地 .m2） -->
        <dependency>
            <groupId>io.github.william853868671</groupId>
            <artifactId>sm-crypto-spring-boot-starter</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
